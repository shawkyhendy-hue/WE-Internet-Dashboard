WE_USERNAME=your_username
WE_PASSWORD=your_password
WE_LOGIN_URL=https://my.te.eg/
SYNC_INTERVAL_MINUTES=60
DASHBOARD_REFRESH_SECONDS=60

WE_USE_INSTALLED_CHROME=1

# Interactive WE verification/CAPTCHA wait (seconds)
SYNC_INTERVAL_MINUTES=60
WE_BROWSER_HEADLESS=1
WE_USE_INSTALLED_CHROME=1
WE_DIAGNOSTIC_CAPTURE=0
WE_CAPTCHA_TIMEOUT_SECONDS=240


# Persistent storage (kept outside application version folders)
WE_DATA_DIR=%USERPROFILE%\WE-Dashboard-Data
BACKUP_RETENTION_DAYS=30
