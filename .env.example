WE_LOGIN_URL=https://my.te.eg/
# Automatic background synchronization interval (minutes)
SYNC_INTERVAL_MINUTES=60
# Dashboard browser refresh interval (seconds)
DASHBOARD_REFRESH_SECONDS=60
# Seconds to wait after successful WE login while authenticated APIs load
WE_WAIT_AFTER_LOGIN_SECONDS=8
# 1 = hidden Chromium, 0 = show browser for troubleshooting
WE_BROWSER_HEADLESS=1
# Prefer locally installed Google Chrome for WE compatibility
WE_USE_INSTALLED_CHROME=1
# Leave 0 for production/live data only. Set 1 only if you want demo rows.
SEED_SAMPLE_DATA=0
# Diagnostics contain only URLs / response shapes / page preview, not raw JSON. Disabled by default.
WE_DIAGNOSTIC_CAPTURE=0
# Optional: set a Fernet key instead of generated .we_secret.key
# WE_DASHBOARD_SECRET_KEY=

# Interactive WE verification/CAPTCHA wait (seconds)
WE_CAPTCHA_TIMEOUT_SECONDS=240

# Persistent storage (kept outside application version folders)
WE_DATA_DIR=%USERPROFILE%\WE-Dashboard-Data
BACKUP_RETENTION_DAYS=30

# Run one background WE sync whenever the main dashboard page is opened
AUTO_SYNC_ON_PAGE_OPEN=0

# Orange Home DSL provider support
ORANGE_LOGIN_URL=https://www.orange.eg/ar/myaccount/login?ReturnUrl=%2Far%2F
ORANGE_ACCOUNT_URL=https://www.orange.eg/ar/myaccount/
ORANGE_INTERNET_URL=https://www.orange.eg/ar/myaccount/internet
ORANGE_TARIFF_URL=https://www.orange.eg/ar/myaccount/manage-tariff
ORANGE_CAPTCHA_TIMEOUT_SECONDS=240
